# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Public Client Credentials (Safe for browser/frontend use)
# Found in Supabase Project Settings -> API
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key"

# Supabase Server-Only Secret (Optional: for privileged backend / edge function jobs)
# NEVER expose this key in browser code or client bundles.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# --- New-drop buyer emails (server-side only) ---
# Set these in Supabase → Project Settings → Edge Functions → Secrets
# (https://supabase.com/dashboard/project/evtgtzgrnvzjnrkmnwcx/functions).
# Do NOT add them as Vercel VITE_* vars. The Vite app never sends mail.
#
# Required:
#   RESEND_API_KEY   Resend API key (starts with re_). Domain gonezy.com
#                    is already verified. Create a key at https://resend.com/api-keys
#                    — this is not the Auth SMTP password.
# Optional:
#   GONEZY_APP_URL   Deep-link origin. Defaults to https://gonezy.com
#                    Set to https://gonezy.vercel.app if the custom domain is down.

